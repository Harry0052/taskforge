{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Harry0052/taskforge/schema/cost-profile-1.0.0.json",
  "title": "TaskForge cost profile 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "currency",
    "horizon",
    "forecast_volume",
    "variable_cost_mode",
    "baseline",
    "specialist",
    "quality_gate"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "profile_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "currency": {"const": "USD"},
    "horizon": {"type": "string", "minLength": 1, "maxLength": 80},
    "forecast_volume": {"type": "integer", "minimum": 1, "maximum": 1000000000000},
    "variable_cost_mode": {"enum": ["modeled", "observed_review"]},
    "baseline": {"$ref": "#/$defs/party"},
    "specialist": {"$ref": "#/$defs/party"},
    "quality_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_macro_f1", "min_per_class_recall"],
      "properties": {
        "min_macro_f1": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,4})?$"},
        "min_per_class_recall": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,4})?$"}
      }
    },
    "sensitivity_review_costs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,4})?$"}
    }
  },
  "$defs": {
    "party": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixed_cost",
        "components",
        "inference_cost_per_request",
        "review_cost_per_item",
        "provenance"
      ],
      "properties": {
        "fixed_cost": {"$ref": "#/$defs/money"},
        "components": {
          "type": "object",
          "additionalProperties": false,
          "required": ["labeling", "training", "integration"],
          "properties": {
            "labeling": {"$ref": "#/$defs/money"},
            "training": {"$ref": "#/$defs/money"},
            "integration": {"$ref": "#/$defs/money"}
          }
        },
        "inference_cost_per_request": {"$ref": "#/$defs/money"},
        "review_cost_per_item": {"$ref": "#/$defs/money"},
        "modeled_variable_cost_per_request": {"$ref": "#/$defs/money"},
        "provenance": {"enum": ["analyst-supplied", "recorded"]}
      }
    },
    "money": {"type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,4})?$"}
  }
}
