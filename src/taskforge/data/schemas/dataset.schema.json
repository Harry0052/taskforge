{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Harry0052/taskforge/schema/dataset-1.0.0.json",
  "title": "TaskForge dataset 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "task_schema_version", "label_set", "items"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "task_id": {"const": "facilities-work-order-routing"},
    "task_schema_version": {"const": "1.0.0"},
    "label_set": {
      "const": ["custodial", "electrical", "hvac", "plumbing"]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "text", "label", "template_family", "split"],
        "properties": {
          "item_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
          "text": {"type": "string", "minLength": 1, "maxLength": 2000},
          "label": {"enum": ["custodial", "electrical", "hvac", "plumbing"]},
          "template_family": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
          "split": {"enum": ["train", "validation", "evaluation"]}
        }
      }
    }
  }
}
